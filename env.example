# Expeta系统环境变量示例文件
# 复制此文件为.env并填入您的实际密钥和配置

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant向量数据库配置
QDRANT_HOST=your_qdrant_host_here  # 例如: c1d98dfd-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-west-2-0.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here

# 集合名称配置（可选，使用默认值即可）
# QDRANT_DOCS_COLLECTION=doc_index
# QDRANT_ENTITY_COLLECTION=entity_summaries
# QDRANT_REASONING_COLLECTION=reasoning_log
# QDRANT_GLOBAL_DECISIONS_COLLECTION=global_decisions

# 日志配置
LOG_LEVEL=INFO  # 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL 